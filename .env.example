# ============================================================
# CONFIGURACIÓN DEL BOT DE WHATSAPP - RESERVAS DE RESTAURANTE
# ============================================================
# Copiá este archivo como .env y completá los valores

# ----------------------------------------------------------
# GOOGLE GEMINI (IA)
# Obtené gratis en: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI_AQUI

# ----------------------------------------------------------
# GOOGLE SHEETS (Base de datos)
# ID del spreadsheet (parte de la URL de Google Sheets)
# Ejemplo: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
# ----------------------------------------------------------
GOOGLE_SHEETS_ID=TU_SPREADSHEET_ID_AQUI

# Ruta al archivo JSON de la Service Account de Google
# Descargalo desde Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/service-account.json

# ----------------------------------------------------------
# CONFIGURACIÓN DEL BOT (opcional)
# ----------------------------------------------------------
# Nivel de logs: trace | debug | info | warn | error
LOG_LEVEL=info

# Puerto para health check (útil en Railway/Render)
PORT=3000

# Rate limiting: máximo de mensajes por usuario por ventana de tiempo
# RATE_MAX=10          (default: 10 mensajes)
# RATE_VENTANA_MS=60000  (default: 60 segundos)
