# ============================================================
# CONFIGURACIÓN DEL BOT DE WHATSAPP - RESERVAS DE RESTAURANTE
# ============================================================
# Copiá este archivo como .env y completá los valores

# ----------------------------------------------------------
# GOOGLE GEMINI (IA)
# Obtené gratis en: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI_AQUI

# ----------------------------------------------------------
# POSTGRESQL (Base de datos)
# Sin Docker: URL completa de conexión
# Con Docker: solo necesitás POSTGRES_PASSWORD; DATABASE_URL se arma en docker-compose
# ----------------------------------------------------------
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/reservas

# Contraseña de PostgreSQL (usada por docker-compose para crear el contenedor)
POSTGRES_PASSWORD=cambia_esta_contraseña

# ----------------------------------------------------------
# CONFIGURACIÓN DEL BOT (opcional)
# ----------------------------------------------------------
# Nivel de logs: trace | debug | info | warn | error
LOG_LEVEL=info

# Puerto para health check (útil en Railway/Render)
PORT=3000

# Rate limiting: máximo de mensajes por usuario por ventana de tiempo
# RATE_MAX=10          (default: 10 mensajes)
# RATE_VENTANA_MS=60000  (default: 60 segundos)

# ----------------------------------------------------------
# PANEL DE ADMINISTRACIÓN
# Accesible en http://TU_HOST:PORT/admin
# Dejá vacío o sin definir para deshabilitar el panel
# ----------------------------------------------------------
ADMIN_TOKEN=CAMBIA_ESTO_POR_UNA_CLAVE_SECRETA
